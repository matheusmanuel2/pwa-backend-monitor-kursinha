# Endpoint que será monitorado
API_URL=https://api.kursinha.com/

# Intervalo entre verificações. Mínimo recomendado: 30000 (30 segundos)
CHECK_INTERVAL_MS=60000

# Quantas falhas consecutivas são necessárias antes de avisar que caiu
FAILURE_THRESHOLD=2

# Tempo máximo de cada chamada HTTP
REQUEST_TIMEOUT_MS=10000

# Porta do servidor
PORT=3000

# Identificação exigida pelo padrão Web Push
VAPID_SUBJECT=mailto:admin@seudominio.com

# Opcional: proteja o painel e as inscrições com uma senha/token
# ACCESS_TOKEN=troque-por-uma-senha-grande

# Opcional: informe chaves fixas em produção. Sem elas, o app gera e salva em data/vapid.json
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Diretório persistente para inscrições, estado e chaves
DATA_DIR=./data
